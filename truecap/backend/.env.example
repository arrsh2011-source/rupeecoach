# Copy to .env and fill in. Never commit .env.
TRUECAP_ENVIRONMENT=development
TRUECAP_DATABASE_URL=sqlite:///./truecap.db
# Production example: postgresql+psycopg://user:pass@host:5432/truecap

TRUECAP_ANTHROPIC_API_KEY=
# Free key: register at data.gov.in -> My Account -> API key
TRUECAP_DATA_GOV_IN_API_KEY=
# Resource ids of the "Company Master Data" datasets (one per state / RoC) you want searched,
# comma-separated. Find each on data.gov.in -> dataset page -> API tab.
TRUECAP_DATA_GOV_IN_RESOURCE_IDS=

TRUECAP_ADMIN_EMAIL=
TRUECAP_JWT_SECRET=change-me
TRUECAP_GOOGLE_CLIENT_ID=

TRUECAP_DAILY_REPORTS_PER_USER=5
TRUECAP_MONTHLY_LLM_BUDGET_INR=800
TRUECAP_CACHE_TTL_DAYS=14
